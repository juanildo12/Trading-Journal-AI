# Claude API key: powers diary analysis, day review, weekly summary, and the Brain chat (get one at console.anthropic.com)
ANTHROPIC_API_KEY=
# Groq API key: FREE tier, and it takes priority over ANTHROPIC_API_KEY when set.
# Powers the same AI features (brain.chat, diary analysis, day review, weekly summary).
# Get one at console.groq.com. Note: image/vision diary upload needs Anthropic —
# Groq's free tier is text-only.
GROQ_API_KEY=
# Optional. Which free Groq model to use. Default: openai/gpt-oss-120b
# Alternatives: qwen/qwen3.8-27b, openai/gpt-oss-20b
GROQ_MODEL=
# Alpaca market-data key id: powers the intraday price charts (free account at alpaca.markets)
APCA_API_KEY_ID=
# Alpaca market-data secret key
APCA_API_SECRET_KEY=
# Optional. Defaults to "iex", which works on a free Alpaca account. Set to "sip"
# only if your key has a paid market-data subscription.
ALPACA_DATA_FEED=
