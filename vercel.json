{
  "version": 2,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://trading-journal-ai-backend.onrender.com/:path*" },
    { "source": "/docs", "destination": "https://trading-journal-ai-backend.onrender.com/docs" },
    { "source": "/redoc", "destination": "https://trading-journal-ai-backend.onrender.com/redoc" },
    { "source": "/openapi.json", "destination": "https://trading-journal-ai-backend.onrender.com/openapi.json" },
    { "source": "/uploads/:path*", "destination": "https://trading-journal-ai-backend.onrender.com/uploads/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
