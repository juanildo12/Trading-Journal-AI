{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    },
    {
      "src": "api/main.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/api/:match*", "destination": "/api/main.py" },
    { "source": "/:match*", "destination": "/frontend/$1" }
  ],
  "redirects": [
    { "source": "/api", "destination": "/api/" }
  ]
}
