{
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "build" } },
    { "src": "api/main.py", "use": "@vercel/python" }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/main.py" },
    { "source": "/docs", "destination": "/api/main.py" },
    { "source": "/redoc", "destination": "/api/main.py" },
    { "source": "/openapi.json", "destination": "/api/main.py" },
    { "source": "/uploads/:path*", "destination": "/api/main.py" },
    { "source": "/:path*", "destination": "/frontend/build/:path*" }
  ],
  "overrides": [
    { "files": ["frontend/build/**"], "serverless": false }
  ]
}
